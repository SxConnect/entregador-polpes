datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ── Loja (Conta / Tenant Principal) ──────────────────────────────────────
model Store {
  id             String   @id @default(uuid()) @db.Uuid
  core_store_id  String   @unique
  nome           String
  api_key_hash   String   // SHA-256 da API key fornecida ao Core
  webhook_url    String?
  webhook_secret String?
  ativo          Boolean  @default(true)
  settings       Json?    @default("{}") // valor_padrao_corrida, tempo_aceite_segundos, exigir_codigo_confirmacao, exigir_foto, msg_padrao_rastreio
  criado_em      DateTime @default(now())
  atualizado_em  DateTime @updatedAt

  branches        Branch[]
  courier_links   CourierStoreLink[]
  deliveries      Delivery[]
  delivery_events DeliveryEvent[]
  courier_invites CourierInvite[]

  @@map("stores")
}

// ── Unidades / Filiais (Hierarquia: Loja -> Unidade) ────────────────────
model Branch {
  id                String   @id @default(uuid()) @db.Uuid
  store_id          String   @db.Uuid
  core_branch_id    String?  // Id da filial no Core ou número da loja (ex.: "1", "filial_sul")
  nome              String   // Ex.: "Matriz", "Filial Copacabana", "Unidade 02"
  endereco_retirada Json     @default("{}") // logradouro, numero, bairro, cidade, complemento, lat, lng
  telefone          String?
  ativo             Boolean  @default(true)
  is_default        Boolean  @default(false)
  settings          Json?    @default("{}") // Sobrescreve configurações da loja (herança)
  criado_em         DateTime @default(now())
  atualizado_em     DateTime @updatedAt

  store         Store               @relation(fields: [store_id], references: [id], onDelete: Cascade)
  deliveries    Delivery[]
  courier_links CourierBranchLink[]

  @@unique([store_id, core_branch_id])
  @@index([store_id])
  @@map("branches")
}

// ── Entregador (Entidade Global) ─────────────────────────────────────────
model Courier {
  id                    String    @id @default(uuid()) @db.Uuid
  nome                  String
  telefone              String    @unique
  veiculo               String    @default("moto") // moto, bicicleta, carro, a_pe
  placa                 String?
  status                String    @default("offline") // offline, online, em_corrida
  ativo                 Boolean   @default(true)
  consentimento_lgpd_em DateTime?
  consentimento_versao  String?
  criado_em             DateTime  @default(now())
  atualizado_em         DateTime  @updatedAt

  store_links  CourierStoreLink[]
  branch_links CourierBranchLink[]
  deliveries   Delivery[]
  locations    CourierLocation[]
  invites      CourierInvite[]

  @@map("couriers")
}

// ── Vínculo Entregador <-> Loja (Multi-tenant) ───────────────────────────
model CourierStoreLink {
  id             String   @id @default(uuid()) @db.Uuid
  courier_id     String   @db.Uuid
  store_id       String   @db.Uuid
  tipo           String   @default("proprio") // proprio, parceiro
  ativo          Boolean  @default(true)
  todas_unidades Boolean  @default(true) // Se false, atende apenas unidades em CourierBranchLink
  criado_em      DateTime @default(now())
  atualizado_em  DateTime @updatedAt

  courier Courier @relation(fields: [courier_id], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@unique([courier_id, store_id])
  @@index([store_id])
  @@index([courier_id])
  @@map("courier_store_links")
}

// ── Vínculo Específico Entregador <-> Unidade (Filial) ───────────────────
model CourierBranchLink {
  id         String   @id @default(uuid()) @db.Uuid
  courier_id String   @db.Uuid
  branch_id  String   @db.Uuid
  ativo      Boolean  @default(true)
  criado_em  DateTime @default(now())
  atualizado_em DateTime @updatedAt

  courier Courier @relation(fields: [courier_id], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([courier_id, branch_id])
  @@index([branch_id])
  @@index([courier_id])
  @@map("courier_branch_links")
}

// ── Convites de Entregadores ─────────────────────────────────────────────
model CourierInvite {
  id         String    @id @default(uuid()) @db.Uuid
  token      String    @unique
  courier_id String    @db.Uuid
  store_id   String    @db.Uuid
  expira_em  DateTime
  usado_em   DateTime?
  criado_em  DateTime  @default(now())

  courier Courier @relation(fields: [courier_id], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id])
  @@index([courier_id])
  @@map("courier_invites")
}

// ── Entregas / Corridas ──────────────────────────────────────────────────
model Delivery {
  id                  String    @id @default(uuid()) @db.Uuid
  store_id            String    @db.Uuid
  branch_id           String    @db.Uuid // Unidade de onde sai a entrega
  core_order_id       String
  courier_id          String?   @db.Uuid
  status              String    @default("pendente") // pendente, atribuido, aceito, coletado, em_rota, entregue, cancelado, recusado
  endereco_retirada   Json      // Endereço da unidade
  endereco_entrega    Json      // Endereço de destino do cliente
  entrega_lat         Float?
  entrega_lng         Float?
  cliente_nome        String
  cliente_telefone    String
  valor_corrida       Float     @default(0.0)
  codigo_confirmacao  String    @db.VarChar(10) // Código de 4 dígitos informado pelo cliente
  foto_comprovante_url String?
  tracking_token      String    @unique @default(uuid())

  // Timestamps de cada etapa da máquina de estados
  criado_em     DateTime  @default(now())
  atribuido_em  DateTime?
  aceito_em     DateTime?
  coletado_em   DateTime?
  em_rota_em    DateTime?
  entregue_em   DateTime?
  cancelado_em  DateTime?
  atualizado_em DateTime  @updatedAt

  store   Store            @relation(fields: [store_id], references: [id], onDelete: Cascade)
  branch  Branch           @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  courier Courier?         @relation(fields: [courier_id], references: [id], onDelete: SetNull)
  events  DeliveryEvent[]

  @@unique([store_id, core_order_id])
  @@index([store_id, status])
  @@index([branch_id, status])
  @@index([courier_id, status])
  @@index([tracking_token])
  @@map("deliveries")
}

// ── Log Imutável de Eventos da Entrega ───────────────────────────────────
model DeliveryEvent {
  id          String   @id @default(uuid()) @db.Uuid
  delivery_id String   @db.Uuid
  store_id    String   @db.Uuid
  status      String
  autor_tipo  String   // loja, entregador, sistema, core
  autor_id    String?
  lat         Float?
  lng         Float?
  payload     Json?
  criado_em   DateTime @default(now())

  delivery Delivery @relation(fields: [delivery_id], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([delivery_id])
  @@index([store_id])
  @@map("delivery_events")
}

// ── Histórico de Localização do Entregador (Rastreio) ───────────────────
model CourierLocation {
  id         String   @id @default(uuid()) @db.Uuid
  courier_id String   @db.Uuid
  lat        Float
  lng        Float
  precisao   Float?
  timestamp  DateTime @default(now())

  courier Courier @relation(fields: [courier_id], references: [id], onDelete: Cascade)

  @@index([courier_id, timestamp])
  @@map("courier_locations")
}
