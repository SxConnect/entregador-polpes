# ── Servidor Fastify ───────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*

# ── Banco de Dados (PostgreSQL) ────────────────────────────────
DATABASE_URL="postgresql://entregador:entregador_secret@localhost:5437/entregador_polpes?schema=public"

# ── Autenticação & Sessão (JWT) ────────────────────────────────
JWT_SECRET="sua_chave_jwt_super_secreta_minimo_32_caracteres_123"
COURIER_SESSION_EXPIRES_IN="30d"

# ── Webhooks & HMAC ───────────────────────────────────────────
WEBHOOK_TIMEOUT_MS=8000
WEBHOOK_MAX_RETRIES=5

# ── VAPID (Web Push Notifications) ─────────────────────────────
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@polpes.com.br"

# ── LGPD e Retenção de Localização ─────────────────────────────
LOCATION_RETENTION_DAYS=30

# ── Domínios & URLs Base ───────────────────────────────────────
PWA_BASE_URL="http://localhost:5173"
TRACKING_BASE_URL="http://localhost:4000/t"
